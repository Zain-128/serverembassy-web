# 1. Backend Server API Base URL
# (Local: http://localhost:4000 | Production: Deployed API base URL)
NEXT_PUBLIC_API_URL=https://api.serverembassy.com

# 2. Canonical Website URL (Used for metadata, Open Graph, and sitemap.xml)
NEXT_PUBLIC_SITE_URL=https://powerlinedevices.com

# 3. Store Identity & Tenant Origins
NEXT_PUBLIC_STORE_NAME=Power Line Devices
NEXT_PUBLIC_STORE_ORIGIN=powerline

# 4. Stripe Payment Gateway (Publishable Key for Checkout)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51R43eyA23918KXk8Ap5QD7vlZ1OlLHekYx1ioxYWDHSKVdS0m9DxZUbA9G3kmMwuPc1HQXP1CGfT5oJH2EB8Lqz400o8shus1V

# 5. 🟢 NEW: Cryptographic Signed URLs Secret Key
# Used for tamper-proof time-limited spec-sheet downloads & order tracking links
SIGNED_URL_SECRET=powerline-enterprise-signed-url-secret-2026-key
